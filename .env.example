# Fireworks (required for LLM calls)
FIREWORKS_API_KEY=
WELLGROUND_LLM_MODEL=accounts/fireworks/models/gpt-oss-120b

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=wellground

# Optional gate between web and api (set on both services when public)
ASK_API_KEY=

# App
WELLGROUND_ENV=development
WELLGROUND_LOG_LEVEL=INFO
WELLGROUND_DATA_DIR=./data
WELLGROUND_DUCKDB_PATH=./data/processed/forge.duckdb
WELLGROUND_CHROMA_PATH=./data/processed/chroma
WELLGROUND_BM25_PATH=./data/processed/bm25
